{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://den-wiki.local/schemas/taxonomy.schema.json",
  "title": "den-wiki taxonomy.yml",
  "description": "The content repo's page types, tag taxonomy and topic tree. A page may only use types, tags and a topic listed here; new ones are added here first.",
  "type": "object",
  "required": [
    "version",
    "types",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Taxonomy file format version.",
      "const": 1
    },
    "types": {
      "description": "Allowed values of a wiki/ page's type field. parent is not used for types.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "tags": {
      "description": "Allowed tags. A tag may name a parent tag to form a hierarchy.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "topics": {
      "description": "The topic tree: subjects that sort pages, one topic per page. A topic may name a parent topic, and an overview page that the reader shows as the topic's entry, with the topic's pages under it. Unlike tags, which cut across concerns, a page sits in exactly one topic.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/topic"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "entry": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "parent": {
          "$ref": "#/$defs/slug"
        }
      },
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "parent": {
          "$ref": "#/$defs/slug"
        },
        "overview": {
          "description": "The wiki page that introduces the topic, e.g. wiki/rusty-dagger.md. The page names this topic itself.",
          "type": "string",
          "pattern": "^wiki/[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*\\.md$"
        }
      },
      "additionalProperties": false
    }
  }
}
