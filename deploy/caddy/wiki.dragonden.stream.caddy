# Site block for CT 104's /etc/caddy/Caddyfile. Certificates come from the
# global cert_issuer (Cloudflare DNS challenge). Everything is open on the LAN
# like den.dragonden.stream: the den-wiki service's paths, and the
# OpenKnowledge UI, which gives full control to whoever reaches it.
wiki.dragonden.stream {
	@facade path /mcp /mcp/* /healthz /version /v1/* /media/*
	handle @facade {
		reverse_proxy 192.168.1.13:7341 {
			stream_close_delay 5m
		}
	}
	handle {
		reverse_proxy 192.168.1.13:4800 {
			# Close streams on a timer after a reload so one stuck
			# WebSocket client cannot hang the reload.
			stream_close_delay 5m
			flush_interval -1
		}
	}
}
